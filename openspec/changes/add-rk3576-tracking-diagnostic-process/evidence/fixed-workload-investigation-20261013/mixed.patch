+        if (!components) {
+            throw std::runtime_error(components.error.describe());
+        }
+        YoloResult detected{};
+        {
+            YoloV8Detector detector{
+                std::move(components.value.yolo), std::move(components.value.yolo_preprocessor), .5f, .45f, 0, 1.0f};
+            if (!detector.init() || !detector.request(first.value, 1)) {
+                throw std::runtime_error("Real YOLO start failed");
+            }
+            const auto deadline{diagnostics::monotonicNs() + 3000000000ULL};
+            while (!detector.get_result(detected)) {
+                if (diagnostics::monotonicNs() >= deadline) {
+                    throw std::runtime_error("YOLO deadline");
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds{1});
+            }
+            if (!detected.has_target) {
+                throw std::runtime_error("First frame has no actual YOLO target");
+            }
+            detector.stop();
+        }
+        // 实际一次检测在预热前完成；测量期按固定调用20读取来源1，不运行检测线程。
+        std::ostringstream box{};
+        box << std::setprecision(9) << detected.best.box.x << ',' << detected.best.box.y << ','
+            << detected.best.box.width << ',' << detected.best.box.height << ',' << detected.best.score;
+        setenv("DRONE_FIXED_SCHEDULE", "1", 1);
+        setenv("DRONE_FIXED_BOX", box.str().c_str(), 1);
+        metadata << "fixed_box=" << box.str() << "\nobserver=" << observed << "\naudit=" << audit << '\n';
+        components = factory->createTrackerComponents(paths);
+        if (!components) {
+            throw std::runtime_error(components.error.describe());
+        }
+        std::ofstream audit_file{std::string{argv[4]} + "/model-audit.csv"};
+        audit_file << "update,kind,input_sha256,classification_sha256,location_sha256,ok\n";
+        AuditNano *counted{};
+        if (audit || mixed) {
+            auto counter{std::make_unique<AuditNano>(std::move(components.value.nano), audit_file, audit)};
+            counted = counter.get();
+            components.value.nano = std::move(counter);
+        }
+        TrackerSettings settings{};
+        settings.enable_dcf = false;
+        settings.yolo_conf_threshold = .5f;
+        settings.yolo_nms_threshold = .45f;
+        settings.kf_fx = 1333.3;
+        settings.kf_fy = 1333.3;
+        settings.kf_cx0 = gray.cols / 2;
+        settings.kf_cy0 = gray.rows / 2;
+        auto tracker{HybridTracker::CreateInstance(settings, std::move(components.value))};
+        if (!tracker->init()) {
+            throw std::runtime_error("Tracker init failed");
+        }
+        std::array<FrameContext, 40> frames{};
+        for (int i{}; i < 40; ++i) {
+            frames[i].frame = builder.value->copyFrom(gray, 1000000 + i * 16667).value;
+            frames[i].now_us = 1000000 + i * 16667;
+        }
+        Observer observer{};
+        std::array<std::uint64_t, 10000> clock_cost{}, cpu_cost{}, observer_cost{};
+        for (std::size_t i{}; i < clock_cost.size(); ++i) {
+            auto start{diagnostics::monotonicNs()};
+            clock_cost[i] = diagnostics::monotonicNs() - start;
+            start = diagnostics::monotonicNs();
+            cpuNs();
+            cpuNs();
+            cpu_cost[i] = diagnostics::monotonicNs() - start;
+            start = diagnostics::monotonicNs();
+            auto id{observer.begin(timing::Stage::Run)};
+            observer.end(id, true);
+            observer_cost[i] = diagnostics::monotonicNs() - start;
+        }
+        std::ofstream calibration{std::string{argv[4]} + "/calibration.csv"};
+        calibration << "clock_ns,two_thread_clock_ns,observer_span_ns,event_hook_ns,preparation_empty_ns\n";
+        for (std::size_t i{}; i < clock_cost.size(); ++i) {
+            calibration << clock_cost[i] << ',' << cpu_cost[i] << ',' << observer_cost[i] << ',';
+            Sample calibration_sample{};
+            sample = &calibration_sample;
+            auto hook_start{diagnostics::monotonicNs()};
+            hook(diagnostics::event(diagnostics::Type::UpdateEnd));
+            calibration << diagnostics::monotonicNs() - hook_start << ',';
+            hook_start = diagnostics::monotonicNs();
+            auto preparation_start{diagnostics::monotonicNs()};
+            preparationHook(diagnostics::monotonicNs() - preparation_start, diagnostics::Type::UpdateEnd);
+            calibration << diagnostics::monotonicNs() - hook_start << '\n';
+            sample = nullptr;
+        }
+        // 两个完整固定块预热；测量样本不删慢值。
+        for (int block{}; block < 2; ++block) {
+            tracker->finishRound();
+            tracker->reset();
+            for (auto &frame : frames) {
+                tracker->update(frame);
+            }
+        }
+        diagnostics::Client client{};
+        const auto mode{(std::string{argv[1]} == "basic" || mixed) ? diagnostics::Mode::Basic : diagnostics::Mode::Off};
+        if (!client.prepare(mode, argv[2])) {
+            throw std::runtime_error("Client prepare failed");
+        }
+        auto *const basic_recorder{diagnostics::active.load()};
+        std::array<int, MAX_CALLS / 40> assignment{};
+        std::mt19937 generator{seed};
+        if (mixed) {
+            for (int index{}; index < cycles; index += 2) {
+                assignment[index] = generator() & 1U;
+                assignment[index + 1] = 1 - assignment[index];
+            }
+        } else {
+            assignment.fill(mode == diagnostics::Mode::Basic ? 1 : 0);
+        }
+        std::ofstream blocks{std::string{argv[4]} + "/blocks.csv"};
+        blocks << "block,pair,mode,templates,searches,drain_wait_ns,drain_complete,behavior_same\n";
+        std::ofstream partial{std::string{argv[4]} + "/partial-calls.csv"};
+        partial << "index,block,pair,mode,position,start_ns,duration_ns,cpu_ns,state,tracking,consumed,score,x,y,w,h\n";
+        partial << std::setprecision(9);
+        metadata << "mixed=" << mixed << "\nseed=" << seed
+                 << "\nboundary_minimum_wait_ns=100000000\nboundary_maximum_wait_ns=250000000\n";
+        diagnostics::measurement = observed ? measured.get() : nullptr;
+        diagnostics::fixed_hook = observed || audit ? hook : nullptr;
+        diagnostics::fixed_preparation_hook = observed ? preparationHook : nullptr;
+        timing::Observation observation{observed ? &observer : nullptr};
+        for (int block{}; block < cycles; ++block) {
+            tracker->finishRound();
+            std::uint64_t boundary_elapsed{};
+            if (mixed) {
+                diagnostics::active.store(nullptr, std::memory_order_release);
+                const auto boundary_start{diagnostics::monotonicNs()};
+                std::this_thread::sleep_for(std::chrono::milliseconds{100});
+                bool complete{};
+                while (diagnostics::monotonicNs() - boundary_start < 250000000ULL) {
+                    complete = client.region()->oldest_unsynced_ns.load() == 0 &&
+                               client.region()->sync_finished_ns.load() >= client.region()->sync_started_ns.load();
+                    for (const auto &producer : client.region()->producers) {
+                        complete = complete && producer.position.written.load() == producer.position.generated.load() &&
+                                   producer.position.synced.load() == producer.position.generated.load() &&
+                                   producer.normal.write.load() == producer.normal.read.load() &&
+                                   producer.critical.write.load() == producer.critical.read.load();
+                    }
+                    if (complete) {
+                        break;
+                    }
+                    std::this_thread::sleep_for(std::chrono::milliseconds{1});
+                }
+                boundary_elapsed = diagnostics::monotonicNs() - boundary_start;
+                if (!complete || client.region()->error.load()) {
+                    throw std::runtime_error("Mixed boundary not fully drained and synced");
+                }
+                diagnostics::active.store(assignment[block] ? basic_recorder : nullptr, std::memory_order_release);
+            }
+            tracker->reset();
+            diagnostics::current_round = block + 1;
+            if (client.region()) {
+                client.region()->round_id = block + 1;
+            }
+            const auto templates_before{counted ? counted->templates_ : 0},
+                searches_before{counted ? counted->searches_ : 0};
+            for (int i{}; i < 40; ++i) {
+                sample = &(*samples)[block * 40 + i];
+                const auto cpu{cpuNs()};
+                sample->begin = diagnostics::monotonicNs();
+                sample->output = tracker->update(frames[i]);
+                sample->ns = diagnostics::monotonicNs() - sample->begin;
+                sample->cpu = cpuNs() - cpu;
+                sample->score = tracker->lastNanoScore();
+                sample->box = tracker->lastNanoBox();
+                sample = nullptr;
+            }
+            if (mixed) {
+                const auto same_box = [](const BBoxRect &a, const BBoxRect &b) {
+                    return a.cx == b.cx && a.cy == b.cy && a.width == b.width && a.height == b.height &&
+                           a.is_valid == b.is_valid;
+                };
+                bool same{true};
+                for (int index{}; index < 40; ++index) {
+                    const auto &a{(*samples)[index]}, &b{(*samples)[block * 40 + index]};
+                    same = same && a.score == b.score && a.box == b.box && a.output.state == b.output.state &&
+                           a.output.consumed == b.output.consumed && a.output.tracking == b.output.tracking &&
+                           same_box(a.output.display_box, b.output.display_box) &&
+                           same_box(a.output.realtime_box, b.output.realtime_box);
+                }
+                blocks << block << ',' << block / 2 << ',' << assignment[block] << ','
+                       << counted->templates_ - templates_before << ',' << counted->searches_ - searches_before << ','
+                       << boundary_elapsed << ",1," << same << '\n';
+                blocks.flush();
+                for (int index{}; index < 40; ++index) {
+                    const auto &value{(*samples)[block * 40 + index]};
+                    partial << block * 40 + index << ',' << block << ',' << block / 2 << ',' << assignment[block] << ','
+                            << index + 1 << ',' << value.begin << ',' << value.ns << ',' << value.cpu << ','
+                            << static_cast<int>(value.output.state) << ',' << value.output.tracking << ','
+                            << value.output.consumed << ',' << value.score << ',' << value.box.x << ',' << value.box.y
+                            << ',' << value.box.width << ',' << value.box.height << '\n';
+                }
+                partial.flush();
+                if (!partial) {
+                    throw std::runtime_error("Mixed partial export failed");
+                }
+                if (!same || counted->templates_ - templates_before != 1 ||
+                    counted->searches_ - searches_before != 39) {
+                    throw std::runtime_error("Mixed actual model workload or output changed");
+                }
+            }
+        }
+        diagnostics::fixed_hook = nullptr;
+        diagnostics::fixed_preparation_hook = nullptr;
+        tracker->finishRound();
+        if (mixed) {
+            diagnostics::active.store(basic_recorder, std::memory_order_release);
+        }
+        client.finish();
+        if (client.region()) {
+            for (std::size_t i{}; i < diagnostics::PRODUCERS; ++i) {
+                metadata << "dropped_" << i << '=' << client.region()->producers[i].position.dropped.load() << '\n';
+            }
+        }
+        diagnostics::exportMeasurement(argv[4]);
+        diagnostics::measurement = nullptr;
+        std::ofstream out{std::string{argv[4]} + "/fixed-calls.csv"};
+        out << "index,block,position,start_ns,duration_ns,cpu_ns,events,event_hash,init,steps,init_ns,step_ns,state,"
+               "tracking,consumed,score,x,y,w,h,dcx,dcy,dw,dh,dvalid,rcx,rcy,rw,rh,rvalid,preparation_ns,preparation_"
+               "count,mode";
+        for (std::size_t i{}; i < timing::stageCount; ++i) {
+            out << ",stage_" << i << "_ns,stage_" << i << "_count";
+        }
+        out << '\n';
+        out << std::setprecision(9);
+        for (int n{}; n < cycles * 40; ++n) {
+            const auto &v{(*samples)[n]};
+            const auto &d{v.output.display_box};
+            const auto &r{v.output.realtime_box};
+            out << n << ',' << n / 40 << ',' << n % 40 + 1 << ',' << v.begin << ',' << v.ns << ',' << v.cpu << ','
+                << v.events << ',' << v.event_hash << ',' << v.init << ',' << v.steps << ',' << v.init_ns << ','
+                << v.step_ns << ',' << static_cast<int>(v.output.state) << ',' << v.output.tracking << ','
+                << v.output.consumed << ',' << v.score << ',' << v.box.x << ',' << v.box.y << ',' << v.box.width << ','
+                << v.box.height << ',' << d.cx << ',' << d.cy << ',' << d.width << ',' << d.height << ',' << d.is_valid
+                << ',' << r.cx << ',' << r.cy << ',' << r.width << ',' << r.height << ',' << r.is_valid << ','
+                << v.preparation_ns << ',' << v.preparation_count << ',' << assignment[n / 40];
+            for (std::size_t i{}; i < timing::stageCount; ++i) {
+                out << ',' << v.stages[i] << ',' << v.counts[i];
+            }
+            out << '\n';
+        }
+        timespec resolution{};
+        clock_getres(CLOCK_MONOTONIC, &resolution);
+        metadata << "clock_resolution_ns=" << resolution.tv_nsec << "\ncycles=" << cycles << '\n';
+        return out && metadata ? 0 : 3;
+    } catch (const std::exception &error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
