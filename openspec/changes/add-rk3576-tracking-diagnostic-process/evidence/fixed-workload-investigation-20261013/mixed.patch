+        cpu_affinity::apply(cpu_affinity::Role::Tracking);
+        const bool observed{std::atoi(argv[6]) != 0}, audit{std::atoi(argv[7]) != 0};
+        const bool mixed{std::string{argv[1]} == "mixed"};
