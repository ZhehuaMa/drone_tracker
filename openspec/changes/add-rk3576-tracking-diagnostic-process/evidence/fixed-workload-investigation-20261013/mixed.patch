+/** @brief 隔离归因程序；正式节点不会调用本文件的模式切换或工作量计数。 */
+namespace {
+constexpr std::size_t MAX_CALLS{4800};
+std::uint64_t cpuNs() {
+    timespec t{};
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t);
+    return t.tv_sec * 1000000000ULL + t.tv_nsec;
+}
+std::string hash(const void *data, std::size_t bytes) {
+    std::array<unsigned char, SHA256_DIGEST_LENGTH> out{};
+    SHA256(static_cast<const unsigned char *>(data), bytes, out.data());
+    std::ostringstream text{};
+    text << std::hex << std::setfill('0');
+    for (unsigned char c : out) {
+        text << std::setw(2) << static_cast<int>(c);
+    }
+    return text.str();
+}
+struct Sample {
+    std::uint64_t ns{}, cpu{}, begin{}, event_hash{1469598103934665603ULL};
+    std::uint32_t events{}, init{}, steps{}, preparation_count{};
+    std::uint64_t preparation_ns{};
+    std::uint64_t init_ns{}, step_ns{};
+    std::array<std::uint64_t, timing::stageCount> stages{};
+    std::array<std::uint32_t, timing::stageCount> counts{};
+    TrackerOutput output{};
+    float score{};
+    cv::Rect2f box{};
+};
+Sample *sample{};
+void hook(const diagnostics::Event &input) noexcept {
+    if (!sample) {
+        return;
+    }
+    auto event{input};
+    event.mono_ns = 0;
+    event.duration_ns = 0;
+    event.run_id = 0;
+    event.round_id = 0;
+    // 身份在每个独立模式按同一调用序列取得；只排除纯耗时。
+    const auto *bytes{reinterpret_cast<const unsigned char *>(&event)};
+    for (std::size_t i{}; i < sizeof(event); ++i) {
+        sample->event_hash = (sample->event_hash ^ bytes[i]) * 1099511628211ULL;
+    }
+    ++sample->events;
+    if (input.type == diagnostics::Type::InitializeEnd) {
+        ++sample->init;
+        sample->init_ns += input.duration_ns;
+    }
+    if (input.type == diagnostics::Type::CatchupStep) {
+        ++sample->steps;
+        sample->step_ns += input.duration_ns;
+    }
+}
+void preparationHook(std::uint64_t ns, diagnostics::Type) noexcept {
+    if (sample) {
+        sample->preparation_ns += ns;
+        ++sample->preparation_count;
+    }
+}
+class Observer final : public timing::Observer {
+  public:
+    std::uint32_t begin(timing::Stage stage) noexcept override {
+        const std::uint32_t id{size_++};
+        starts_[id] = diagnostics::monotonicNs();
+        stages_[id] = stage;
+        return id;
+    }
+    void end(std::uint32_t id, bool) noexcept override {
+        const auto index{static_cast<std::size_t>(stages_[id])};
+        if (sample) {
+            sample->stages[index] += diagnostics::monotonicNs() - starts_[id];
+            ++sample->counts[index];
+        }
+        if (id + 1 == size_) {
+            --size_;
+        }
+    }
+
+  private:
+    std::array<std::uint64_t, 128> starts_{};
+    std::array<timing::Stage, 128> stages_{};
+    std::uint32_t size_{};
+};
+class AuditNano final : public model::NanoTrackBackend {
+  public:
+    AuditNano(std::unique_ptr<model::NanoTrackBackend> backend, std::ofstream &out, bool enabled = true)
+        : backend_{std::move(backend)}, out_{out}, enabled_{enabled} {
+    }
+    std::uint64_t templates_{}, searches_{};
+    ModelInputContract templateContract() const override {
+        return backend_->templateContract();
+    }
+    ModelInputContract searchContract() const override {
+        return backend_->searchContract();
+    }
+    model::Status setTemplate(const PreparedInputRef &input) override {
+        ++templates_;
+        auto value{backend_->setTemplate(input)};
+        record("template", input, {}, {}, bool(value));
+        return value;
+    }
+    model::Result<model::NanoPrediction> search(const PreparedInputRef &input) override {
+        ++searches_;
+        auto value{backend_->search(input)};
+        record("search", input, value ? value.value.classification : model::Tensor{},
+               value ? value.value.location : model::Tensor{}, bool(value));
+        return value;
+    }
+    void reset() noexcept override {
+        backend_->reset();
+    }
+
+  private:
+    void record(const char *kind, const PreparedInputRef &input, const model::Tensor &a, const model::Tensor &b,
+                bool ok) {
+        if (!enabled_) {
+            return;
+        }
+        const auto prepared{std::dynamic_pointer_cast<const rk3576::FloatInput>(input)};
+        if (!prepared) {
+            throw std::runtime_error("Unknown Nano input");
+        }
+        out_ << diagnostics::current_update << ',' << kind << ','
+             << hash(prepared->values()->data(), prepared->values()->size() * sizeof(float)) << ','
+             << (a.storage ? hash(a.read().data(), a.storage->byteSize()) : "") << ','
+             << (b.storage ? hash(b.read().data(), b.storage->byteSize()) : "") << ',' << ok << '\n';
+    }
+    std::unique_ptr<model::NanoTrackBackend> backend_;
+    std::ofstream &out_;
+    bool enabled_{};
+};
+} // namespace
+int main(int argc, char **argv) {
+    if (argc != 8) {
+        std::cerr << "mode endpoint video output cycles observer audit\n";
+        return 2;
+    }
