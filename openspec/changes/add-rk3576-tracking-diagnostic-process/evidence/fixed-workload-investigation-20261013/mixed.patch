+                 << "\nheight=" << gray.rows << "\ncv_type=" << gray.type() << "\nrow_stride=" << gray.step[0]
+                 << "\ncv_threads=" << cv::getNumThreads() << '\n';
+        auto builder{factory->createFrameBuilder()};
+        auto first{builder.value->copyFrom(gray, 1000000)};
