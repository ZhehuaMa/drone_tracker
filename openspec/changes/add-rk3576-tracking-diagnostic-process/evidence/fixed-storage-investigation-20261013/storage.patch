+++ b/src/storage_switch_test.cpp
@@ -0,0 +1,81 @@
+#include "diagnostics/client.h"
+#include "diagnostics/storage.h"
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <thread>
+
+int main(int argc, char **argv) {
+    using namespace diagnostics;
+    try {
+        if (argc != 4) {
+            throw std::runtime_error("socket control blocks required");
+        }
+        Client client{};
+        if (!client.prepare(Mode::Basic, argv[1])) {
+            throw std::runtime_error("prepare");
+        }
+        auto *const recorder{active.load()};
+        auto drain = [&] {
+            active.store(nullptr);
+            const auto begin{monotonicNs()};
+            while (monotonicNs() - begin < 500000000ULL) {
+                bool complete{client.region()->oldest_unsynced_ns.load() == 0};
+                for (const auto &p : client.region()->producers) {
+                    complete = complete && p.position.generated.load() == p.position.synced.load() &&
+                               p.position.generated.load() == p.position.written.load() &&
+                               p.normal.write.load() == p.normal.read.load() &&
+                               p.critical.write.load() == p.critical.read.load();
+                }
+                if (complete && !client.region()->error.load()) {
+                    return;
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds{1});
+            }
+            throw std::runtime_error("drain");
+        };
+        const auto control{std::filesystem::path{argv[2]}};
+        for (int block{}; block < std::stoi(argv[3]); ++block) {
+            drain();
+            {
+                std::ofstream out{control / "request.tmp"};
+                out << block << ' ' << block % 2 << '\n';
+            }
+            std::filesystem::rename(control / "request.tmp", control / "request");
+            const auto begin{monotonicNs()};
+            bool acknowledged{};
+            while (monotonicNs() - begin < 500000000ULL) {
+                std::ifstream ack{control / "ack"};
+                int sequence{-1}, mode{-1};
+                if (ack >> sequence >> mode && sequence == block && mode == block % 2) {
+                    acknowledged = true;
+                    break;
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds{1});
+            }
+            if (!acknowledged) {
+                throw std::runtime_error("ack");
+            }
+            active.store(recorder);
+            for (int i{}; i < 20; ++i) {
+                auto value{event(Type::Capture, Reason::None, i == 19)};
+                value.update_id = i + 1;
+                value.round_id = block + 1;
+                if (!recorder->submit(Producer::Node, value)) {
+                    throw std::runtime_error("submit");
+                }
+            }
+        }
+        drain();
+        active.store(recorder);
+        if (!client.finish()) {
+            throw std::runtime_error("finish");
+        }
+        std::cout << "switch protocol passed\n";
+        return 0;
+    } catch (const std::exception &e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
