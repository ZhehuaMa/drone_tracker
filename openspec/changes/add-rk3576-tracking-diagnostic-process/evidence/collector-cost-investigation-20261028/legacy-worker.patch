+constexpr std::array<std::uint32_t, 256> makeCrcTable() noexcept {
+    std::array<std::uint32_t, 256> table{};
+    for (std::size_t index{}; index < table.size(); ++index) {
+        std::uint32_t value{static_cast<std::uint32_t>(index)};
+        for (unsigned bit{}; bit < 8; ++bit) {
+            value = (value >> 1) ^ (0xedb88320U & (0U - (value & 1U)));
+        }
+        table[index] = value;
+    }
+    return table;
+}
+// Keep the existing IEEE CRC-32 bytes without requiring optional ARM CPU instructions.
+constexpr auto CRC_TABLE{makeCrcTable()};
