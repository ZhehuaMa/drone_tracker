#!/usr/bin/env bash
# Both entries validate the shared policy, then pin only the collector to CPU 6.
set -euo pipefail
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
policy=/opt/drone_tracker/config/cpu-affinity.yaml
cpus=$(python3 "$script_dir/cpu-policy.py" "$policy")
exec python3 "$script_dir/diagnostic-launch.py" /opt/drone_tracker/config/diagnostics.yaml "$cpus" "$@"
