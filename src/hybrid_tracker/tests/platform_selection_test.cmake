file(REMOVE_RECURSE "${TEST_ROOT}")
foreach(platform other rk3576 default)
    set(args)
    if(NOT platform STREQUAL "default")
        list(APPEND args -DDRONE_TRACKER_PLATFORM=${platform})
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${REPO_ROOT}" -B "${TEST_ROOT}/${platform}"
        ${args} -DRKNN_INCLUDE_DIR=/missing-sdk -DRKNN_LIBRARY=/missing-library
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(log "${output}\n${error}")
    if(platform STREQUAL "other")
        if(result EQUAL 0 OR NOT log MATCHES "DRONE_TRACKER_PLATFORM='other'.*unsupported; supported: jetson/rk3576")
            message(FATAL_ERROR "未知平台未提前拒绝: ${log}")
        endif()
    elseif(platform STREQUAL "rk3576")
        if(result EQUAL 0 OR NOT log MATCHES "RK3576.*RKNN Runtime 2.3.2" OR NOT log MATCHES "driver 0.9.8")
            message(FATAL_ERROR "RKNN 缺失诊断不完整: ${log}")
        endif()
    else()
        file(STRINGS "${TEST_ROOT}/default/CMakeCache.txt" selected REGEX "DRONE_TRACKER_PLATFORM:STRING=jetson")
        if(NOT selected)
            message(FATAL_ERROR "默认平台不是 Jetson")
        endif()
    endif()
    if(NOT platform STREQUAL "default" AND log MATCHES "Failed to find nvcc|Could not find.*CUDA")
        message(FATAL_ERROR "错误进入 CUDA 发现: ${log}")
    endif()
endforeach()
