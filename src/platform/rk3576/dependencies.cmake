set(RKNN_INCLUDE_DIR "/opt/rknn-runtime/include" CACHE PATH "RKNN SDK include directory (target Runtime 2.3.2; use matching target SDK paths)")
set(RKNN_LIBRARY "/opt/rknn-runtime/lib/librknnrt.so" CACHE FILEPATH "ARM64 librknnrt.so for linking (target Runtime 2.3.2; use matching target SDK paths)")
if(NOT EXISTS "${RKNN_INCLUDE_DIR}/rknn_api.h" OR NOT EXISTS "${RKNN_LIBRARY}")
    message(FATAL_ERROR "RK3576 backends target RKNN Runtime 2.3.2 and driver 0.9.8. Set RKNN_INCLUDE_DIR to the SDK directory containing rknn_api.h and RKNN_LIBRARY to ARM64 librknnrt.so. Current images provide matching Runtime 2.3.2 target files. The x86_64 image uses /opt/toolchains/aarch64-humble.cmake and /opt/arm64-sysroot; the ARM64 image uses native target paths.")
endif()
if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    message(FATAL_ERROR "RK3576 backend requires ARM64 output, not an ARM64 container. Use the ARM cross toolchain in the x86_64 image or a native ARM64 SDK.")
endif()
