if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "RK3576 camera requires Linux V4L2; use the documented ARM64 container")
endif()
find_package(OpenCV REQUIRED COMPONENTS core imgproc dnn video imgcodecs)
find_package(JPEG REQUIRED)
find_package(PkgConfig REQUIRED)
pkg_check_modules(VIDEO_AV REQUIRED IMPORTED_TARGET libavformat libavcodec libavutil)
option(DRONE_TRACKER_BUILD_TESTS "Build camera and common fault injection tests" ON)
enable_testing()
add_subdirectory(../../hybrid_tracker common)
add_library(rk3576_yolo_host STATIC yolo_preprocessor.cpp nanotrack_preprocessor.cpp host_frame.cpp)
target_link_libraries(rk3576_yolo_host PUBLIC hybrid_tracker)
add_library(rk3576_video STATIC mjpeg_video_reader.cpp video_timing.cpp video_frame_source.cpp)
target_link_libraries(rk3576_video PUBLIC rk3576_yolo_host PRIVATE JPEG::JPEG PkgConfig::VIDEO_AV)
add_library(rk3576_ar0234_camera STATIC ar0234_camera_device.cpp rk3576_camera_capture_base.cpp
    camera_timing.cpp ar0234_camera_frame_source.cpp)
target_link_libraries(rk3576_ar0234_camera PUBLIC rk3576_yolo_host)
add_library(rk3576_sc233hgs_camera STATIC sc233hgs_camera_device.cpp sc233hgs_camera_frame_source.cpp)
target_sources(rk3576_sc233hgs_camera PRIVATE recording/session.cpp)
target_link_libraries(rk3576_sc233hgs_camera PUBLIC rk3576_ar0234_camera)
add_library(rk3576_tracker_assembly STATIC tracker_assembly.cpp platform_factory.cpp)
target_link_libraries(rk3576_tracker_assembly PUBLIC rk3576_yolo_host rk3576_video rk3576_ar0234_camera
    rk3576_sc233hgs_camera)
include(ar0234_camera_tests.cmake)
include(sc233hgs_camera_tests.cmake)
