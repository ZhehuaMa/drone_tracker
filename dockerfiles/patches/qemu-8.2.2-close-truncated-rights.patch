--- a/linux-user/syscall.c
+++ b/linux-user/syscall.c
@@ -1829,6 +1829,23 @@
     return 0;
 }
 
+/* recvmsg installs host descriptors before guest ancillary conversion. Linux
+ * closes SCM_RIGHTS descriptors which do not fit the caller's control buffer.
+ * Close the corresponding host descriptors when the guest cannot receive them.
+ */
+static void close_remaining_scm_rights(struct msghdr *msg, struct cmsghdr *cmsg)
+{
+    for (; cmsg; cmsg = CMSG_NXTHDR(msg, cmsg)) {
+        if (cmsg->cmsg_level == SOL_SOCKET && cmsg->cmsg_type == SCM_RIGHTS) {
+            int *fds = (int *)CMSG_DATA(cmsg);
+            size_t count = (cmsg->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+            for (size_t index = 0; index < count; index++) {
+                close(fds[index]);
+            }
+        }
+    }
+}
