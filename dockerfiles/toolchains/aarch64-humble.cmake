# Native CMake/compiler processes generate genuine ARM64 output.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
set(CMAKE_SYSROOT /opt/arm64-sysroot)
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}" CACHE STRING "ARM64 dependency roots")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(DRONE_QEMU_AARCH64 /opt/qemu-arm64/bin/qemu-aarch64)
if(DEFINED ENV{DRONE_QEMU_AARCH64})
  set(DRONE_QEMU_AARCH64 "$ENV{DRONE_QEMU_AARCH64}")
endif()
if(NOT EXISTS "${DRONE_QEMU_AARCH64}")
  message(FATAL_ERROR "Selected ARM emulator is missing: ${DRONE_QEMU_AARCH64}. Rebuild the prepared amd64 image.")
endif()
set(CMAKE_CROSSCOMPILING_EMULATOR "${DRONE_QEMU_AARCH64}";-L;${CMAKE_SYSROOT})
# Run generators natively, while building Python extensions for target Python 3.10.
set(Python3_EXECUTABLE /usr/bin/python3 CACHE FILEPATH "Native Python generator")
set(Python3_LIBRARY "${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu/libpython3.10.so" CACHE FILEPATH "Target Python library")
set(Python3_INCLUDE_DIR "${CMAKE_SYSROOT}/usr/include/python3.10" CACHE PATH "Target Python headers")
set(PYTHON_SOABI cpython-310-aarch64-linux-gnu CACHE INTERNAL "ARM64 Python extension ABI" FORCE)
set(ENV{QEMU_LD_PREFIX} "${CMAKE_SYSROOT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,-rpath-link,${CMAKE_SYSROOT}/opt/ros/humble/lib -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(RKNN_INCLUDE_DIR "${CMAKE_SYSROOT}/opt/rknn-runtime/include" CACHE PATH "RKNN 2.3.2 target headers")
set(RKNN_LIBRARY "${CMAKE_SYSROOT}/opt/rknn-runtime/lib/librknnrt.so" CACHE FILEPATH "ARM64 RKNN Runtime")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu/pkgconfig:${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
