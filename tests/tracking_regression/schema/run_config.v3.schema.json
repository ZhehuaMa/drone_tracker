{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "max_supply_lateness_us",
    "queue_capacity",
    "clock_jump_tolerance_us",
    "ros_domain_id",
    "input_mode",
    "case_id",
    "deadlines",
    "analysis_windows"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "max_supply_lateness_us": {
      "type": "integer",
      "minimum": 1
    },
    "queue_capacity": {
      "type": "integer",
      "minimum": 1
    },
    "supplier_cpu": {
      "type": "integer",
      "minimum": 0
    },
    "clock_jump_tolerance_us": {
      "type": "integer",
      "minimum": 1
    },
    "ros_domain_id": {
      "type": "integer",
      "minimum": 1
    },
    "model_paths": {
      "type": "object",
      "properties": {
        "tracker.yolo_engine": {
          "type": "string",
          "minLength": 1
        },
        "tracker.nano_template_backbone": {
          "type": "string",
          "minLength": 1
        },
        "tracker.nano_search_backbone": {
          "type": "string",
          "minLength": 1
        },
        "tracker.nano_head": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_mode": {
      "type": "string",
      "const": "predecode_all"
    },
    "workload": {
      "type": "string",
      "minLength": 1
    },
    "expected_workload_processes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "deadlines": {
      "type": "object",
      "required": [
        "preparation_seconds",
        "cleanup_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "preparation_seconds": {
          "type": "number",
          "minimum": 1e-06
        },
        "cleanup_seconds": {
          "type": "number",
          "minimum": 1e-06
        }
      }
    },
    "analysis_windows": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
