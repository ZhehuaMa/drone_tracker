{
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "operation",
    "output_root",
    "clips"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "prepare",
        "run",
        "freeze",
        "compare"
      ]
    },
    "output_root": {
      "type": "string",
      "minLength": 1
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "source"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "video",
              "frame_logs",
              "attitude_bags",
              "session"
            ]
          },
          "frame_selection_interval": {
            "type": "object",
            "required": [
              "start_seconds",
              "end_seconds"
            ]
          }
        }
      }
    },
    "rounds": {},
    "deadlines": {},
    "prepare": {},
    "run": {
      "type": "object",
      "properties": {
        "settings": {
          "type": "object",
          "properties": {
            "cpu_affinity": {
              "type": "object",
              "required": [
                "version",
                "mode"
              ],
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "integer",
                  "const": 1
                },
                "mode": {
                  "enum": [
                    "inherit",
                    "role-pinned"
                  ]
                },
                "allowed_cpus": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "supervision_cpus": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "control_cpu": {
                  "type": "integer",
                  "minimum": 0
                },
                "tracking_cpu": {
                  "type": "integer",
                  "minimum": 0
                },
                "yolo_cpu": {
                  "type": "integer",
                  "minimum": 0
                },
                "logger_cpu": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "cpu_observation": {
              "type": "object",
              "required": [
                "version",
                "capacity_per_writer",
                "sampling"
              ],
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "integer",
                  "const": 1
                },
                "capacity_per_writer": {
                  "type": "integer",
                  "minimum": 1
                },
                "sampling": {
                  "const": "all_managed_points"
                }
              }
            }
          }
        }
      }
    },
    "freeze": {},
    "compare": {}
  }
}
