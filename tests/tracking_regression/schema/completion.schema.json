{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "qualified",
    "normal_end",
    "reasons",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "qualified": {
      "type": "boolean"
    },
    "normal_end": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "object"
    }
  }
}
