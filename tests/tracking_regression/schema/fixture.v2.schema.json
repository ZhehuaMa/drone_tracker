{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "frame_count",
    "width",
    "height",
    "pixel_format",
    "duration_us",
    "start_us",
    "end_us",
    "source_epoch_us",
    "sources",
    "files",
    "tool_sha256",
    "ffmpeg_version",
    "analysis_windows",
    "selection_mode",
    "source_start_us",
    "source_end_us"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "duration_us": {
      "type": "integer",
      "minimum": 1
    },
    "source_epoch_us": {
      "type": "integer"
    },
    "files": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1
    }
  }
}
