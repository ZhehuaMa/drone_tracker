{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "reference",
    "candidate",
    "build",
    "observation_patch_sha256",
    "cpu_observation",
    "allowed_differences"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_commit",
        "source_sha256",
        "binary_sha256",
        "project_libraries",
        "source_patch_sha256"
      ],
      "properties": {
        "algorithm_commit": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string",
          "minLength": 1
        },
        "project_libraries": {
          "type": "object"
        },
        "source_patch_sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_commit",
        "source_sha256",
        "binary_sha256",
        "project_libraries",
        "source_patch_sha256"
      ],
      "properties": {
        "algorithm_commit": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string",
          "minLength": 1
        },
        "project_libraries": {
          "type": "object"
        },
        "source_patch_sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "compiler",
        "options"
      ]
    },
    "observation_patch_sha256": {
      "type": "string",
      "minLength": 64
    },
    "cpu_observation": {
      "type": "object"
    },
    "allowed_differences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field",
          "baseline",
          "candidate",
          "audit"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "baseline": {},
          "candidate": {},
          "audit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
