{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "differences",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "status": {
      "enum": [
        "comparable",
        "incomparable"
      ]
    },
    "differences": {
      "type": "array"
    },
    "metrics": {
      "type": "array"
    },
    "experiment_version": {},
    "affinity_experiment": {},
    "original_comparison_groups": {},
    "allowed_differences": {}
  }
}
