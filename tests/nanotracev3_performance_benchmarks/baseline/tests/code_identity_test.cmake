cmake_minimum_required(VERSION 3.16)
find_package(Git REQUIRED)
# 所有修改及提交只发生在本测试拥有的临时仓库中。
file(REMOVE_RECURSE "${TEST_ROOT}")
set(repo "${TEST_ROOT}/repo")
set(build "${TEST_ROOT}/build")
file(MAKE_DIRECTORY "${repo}/src")
function(run)
    execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${repo}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "命令失败: ${ARGV}\n${output}\n${error}")
    endif()
    set(command_output "${output}" PARENT_SCOPE)
endfunction()
function(build_and_read)
    run("${CMAKE_COMMAND}" --build "${build}" --target identity_probe --parallel 2)
    run("${build}/identity_probe")
    set(identity "${command_output}" PARENT_SCOPE)
endfunction()
function(expect_contains needle)
    string(FIND "${identity}" "${needle}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "程序内身份缺少: ${needle}")
    endif()
endfunction()
file(WRITE "${repo}/.gitignore" "ignored.cpp\n")
file(WRITE "${repo}/src/value.h" "#define TEST_VALUE 1\n")
file(WRITE "${repo}/src/main.cpp" [=[
#include <iostream>
#include "value.h"
#include "code_identity.h"
int main() {
    std::cout << TEST_VALUE << '\n' << BASELINE_COMMIT << '\n' << BASELINE_SOURCE_SNAPSHOT;
}
]=])
set(project_text [=[
cmake_minimum_required(VERSION 3.16)
project(identity_fixture LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 17)
include("@BASELINE_SOURCE_DIR@/code_identity.cmake")
add_executable(identity_probe src/main.cpp)
target_include_directories(identity_probe PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
baseline_code_identity(identity_probe "${CMAKE_CURRENT_SOURCE_DIR}")
]=])
string(CONFIGURE "${project_text}" project_text @ONLY)
file(WRITE "${repo}/CMakeLists.txt" "${project_text}")
run("${GIT_EXECUTABLE}" init)
run("${GIT_EXECUTABLE}" add .)
run("${GIT_EXECUTABLE}" -c user.name=IdentityTest -c user.email=identity@example.invalid
    -c commit.gpgsign=false commit -m initial)
run("${CMAKE_COMMAND}" -S "${repo}" -B "${build}" -G "${TEST_GENERATOR}"
    "-DCMAKE_CXX_COMPILER=${TEST_COMPILER}" -DCMAKE_BUILD_TYPE=Release)
build_and_read()
run("${GIT_EXECUTABLE}" rev-parse HEAD)
string(STRIP "${command_output}" commit)
expect_contains("${commit}")

# 仅改普通源码并执行 build，检查实际编译结果与嵌入快照一起更新。
file(WRITE "${repo}/src/value.h" "#define TEST_VALUE 2\n")
file(APPEND "${repo}/src/main.cpp" "// tracked-source-change\n")
build_and_read()
expect_contains("2\n${commit}")
expect_contains("+#define TEST_VALUE 2")
expect_contains("+// tracked-source-change")
file(WRITE "${repo}/src/new_file.cpp" "// untracked-first\n")
build_and_read()
expect_contains("新增文件 src/new_file.cpp")
expect_contains("untracked-first")
file(WRITE "${repo}/src/new_file.cpp" "// untracked-second\n")
build_and_read()
expect_contains("untracked-second")
file(REMOVE "${repo}/src/new_file.cpp")
build_and_read()
string(FIND "${identity}" "新增文件 src/new_file.cpp" removed)
if(NOT removed EQUAL -1)
    message(FATAL_ERROR "已删除的新增文件仍残留于快照")
endif()
run("${GIT_EXECUTABLE}" add src)
build_and_read()
expect_contains("+// tracked-source-change")
run("${GIT_EXECUTABLE}" -c user.name=IdentityTest -c user.email=identity@example.invalid
    -c commit.gpgsign=false commit -m changed)
run("${GIT_EXECUTABLE}" rev-parse HEAD)
string(STRIP "${command_output}" commit)
build_and_read()
if(NOT identity STREQUAL "2\n${commit}\n")
    message(FATAL_ERROR "提交后程序身份未更新或差异未清空")
endif()

# 等待超过文件时间戳分辨率，再证明无改动不会更新头文件、目标文件或程序。
file(GLOB_RECURSE objects "${build}/*main.cpp.o")
if(NOT objects)
    message(FATAL_ERROR "未找到用于检查增量编译的目标文件")
endif()
set(artifacts "${build}/code_identity.h" "${build}/identity_probe" ${objects})
foreach(path IN LISTS artifacts)
    file(TIMESTAMP "${path}" timestamp "%s")
    string(APPEND before "${path}:${timestamp}\n")
endforeach()
run("${CMAKE_COMMAND}" -E sleep 1.1)
build_and_read()
foreach(path IN LISTS artifacts)
    file(TIMESTAMP "${path}" timestamp "%s")
    string(APPEND after "${path}:${timestamp}\n")
endforeach()
if(NOT before STREQUAL after)
    message(FATAL_ERROR "无改动重复构建触发了身份文件或程序重编译")
endif()

# Git 不可用时必须阻止构建，即使旧头文件已经存在。
file(RENAME "${repo}/.git" "${TEST_ROOT}/saved-git")
# 无效 gitdir 阻止 Git 向上误用宿主仓库，独立构建目录可能位于宿主仓库内。
file(WRITE "${repo}/.git" "gitdir: ${TEST_ROOT}/missing-git\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --target identity_probe
    RESULT_VARIABLE failed OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(REMOVE "${repo}/.git")
file(RENAME "${TEST_ROOT}/saved-git" "${repo}/.git")
if(failed STREQUAL "0" OR NOT "${output}${error}" MATCHES "源码身份收集失败")
    message(FATAL_ERROR "Git 身份读取失败时没有阻断构建: ${output}${error}")
endif()
message(STATUS "源码修改、新增/修改/删除文件、暂存、提交、无改动增量构建和 Git 失败检查通过")
